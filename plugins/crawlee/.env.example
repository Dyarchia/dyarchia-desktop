# Copy to .env to change the defaults. The file is ignored by git.
# Every setting is optional; what is shown is the value used when it is absent.

# Where the corpus repositories live: one folder, one subdirectory per repository,
# each of them holding profiles/, data/ and output/ and versioned on its own. Every
# subdirectory with a profiles/ in it is found, so adding a corpus is a clone into
# this folder rather than an edit to this file. It is created if it is named and not
# there, and never filled. Unset, the tool knows one repository, the one the three
# variables below name, which is what it did before this setting existed.
#
#   DYARCHIA_CRAWLEE_REPOSITORIES_DIR=C:/Users/Usuario/ai-department/dyarchia/crawlee-data

# Where snapshots live, where profiles are looked up, and where each run's output
# lands, for the one repository a command falls back to: an ad-hoc crawl of a URL
# belongs to no corpus and still has to write its export somewhere. All accept
# absolute paths, so nothing the toolkit produces has to sit in this checkout, which
# is how this machine runs it:
#
#   DYARCHIA_CRAWLEE_DATA_DIR=C:/Users/Usuario/ai-department/dyarchia/crawlee-data/crawlee-lab-data/data
#   DYARCHIA_CRAWLEE_PROFILES_DIR=C:/Users/Usuario/ai-department/dyarchia/crawlee-data/crawlee-lab-data/profiles
#   DYARCHIA_CRAWLEE_OUTPUT_DIR=C:/Users/Usuario/ai-department/dyarchia/crawlee-data/crawlee-lab-data/output
#
# Nothing reads the data directory except to compare a new run against the previous
# one, so moving it only means saying where it went.
DYARCHIA_CRAWLEE_DATA_DIR=data
DYARCHIA_CRAWLEE_PROFILES_DIR=profiles
DYARCHIA_CRAWLEE_OUTPUT_DIR=output

# Crawlee's working directory: one folder per run, purged at the start and removed
# on exit. Scratch rather than output, so it is worth keeping out of the checkout
# entirely; a run killed mid-flight is what leaves one behind.
DYARCHIA_CRAWLEE_STORAGE_DIR=storage

# How the crawler introduces itself.
DYARCHIA_CRAWLEE_USER_AGENT=dyarchia-crawlee/0.1 (+https://github.com/dyarchia-crawlee; polite crawler)

# Politeness and pacing.
DYARCHIA_CRAWLEE_MIN_CONCURRENCY=1
DYARCHIA_CRAWLEE_DESIRED_CONCURRENCY=3
DYARCHIA_CRAWLEE_MAX_CONCURRENCY=8
DYARCHIA_CRAWLEE_MAX_REQUESTS_PER_MINUTE=60
DYARCHIA_CRAWLEE_MAX_REQUEST_RETRIES=3
DYARCHIA_CRAWLEE_REQUEST_TIMEOUT_SECONDS=60
DYARCHIA_CRAWLEE_RESPECT_ROBOTS=true

# Guards that refuse to write a snapshot from a run that went badly.
# Success rate counts failures among the pages attempted; coverage asks how much
# of the previous snapshot this run reached at all.
DYARCHIA_CRAWLEE_MIN_SUCCESS_RATE=0.9
DYARCHIA_CRAWLEE_MIN_COVERAGE=0.5

# Where the search index goes: one SQLite file per corpus repository, derived from
# the snapshots and never versioned with them. Rebuilt page by page as manifests
# move, so it is cheap to keep out of the checkout and beside the storage directory.
DYARCHIA_CRAWLEE_INDEX_DIR=index

# Browser mode.
DYARCHIA_CRAWLEE_HEADLESS=true

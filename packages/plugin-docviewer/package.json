{
    "name": "@dyarchia/plugin-docviewer",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm build:renderer && pnpm build:main",
        "build:renderer": "esbuild src/renderer.ts --bundle --format=esm --outfile=dist/renderer.js",
        "build:main": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js"
    },
    "devDependencies": {
        "@dyarchia/sdk": "workspace:*",
        "esbuild": "^0.28.2",
        "marked": "^16.4.1",
        "typescript": "^5.9.0"
    }
}

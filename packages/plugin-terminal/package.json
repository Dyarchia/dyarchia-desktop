{
    "name": "@decimatio/plugin-terminal",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm build:renderer && pnpm build:main && pnpm build:ptyhost",
        "build:renderer": "esbuild src/renderer.ts --bundle --format=esm --loader:.css=text --outfile=dist/renderer.js",
        "build:main": "esbuild src/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist/main.js",
        "build:ptyhost": "esbuild src/ptyhost.ts --bundle --platform=node --format=cjs --external:node-pty --outfile=dist/ptyhost.cjs"
    },
    "dependencies": {
        "node-pty": "^1.0.0"
    },
    "devDependencies": {
        "@decimatio/sdk": "workspace:*",
        "@xterm/addon-clipboard": "^0.2.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-unicode11": "^0.9.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0",
        "electron": "43.3.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.0"
    }
}

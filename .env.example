# Copy to .env to change the defaults. The file is ignored by git.
# Every setting is optional; what is shown is the value used when it is absent.

# Where snapshots live, where profiles are looked up, and where each run's output
# lands. All accept absolute paths, so nothing the toolkit produces has to sit in
# this checkout, which is how this machine runs it:
#
#   EURIPONTIDA_CRAWLEE_DATA_DIR=C:/Users/Usuario/ai-department/crawlee-lab-data/data
#   EURIPONTIDA_CRAWLEE_PROFILES_DIR=C:/Users/Usuario/ai-department/crawlee-lab-data/profiles
#   EURIPONTIDA_CRAWLEE_OUTPUT_DIR=C:/Users/Usuario/ai-department/crawlee-lab-data/output
#
# Nothing reads the data directory except to compare a new run against the previous
# one, so moving it only means saying where it went. scripts/watch.ps1 reads this
# file too, for the output directory, so the sweep's log follows the exports.
EURIPONTIDA_CRAWLEE_DATA_DIR=data
EURIPONTIDA_CRAWLEE_PROFILES_DIR=profiles
EURIPONTIDA_CRAWLEE_OUTPUT_DIR=output

# Crawlee's working directory: one folder per run, purged at the start and removed
# on exit. Scratch rather than output, so it is worth keeping out of the checkout
# entirely; a run killed mid-flight is what leaves one behind.
EURIPONTIDA_CRAWLEE_STORAGE_DIR=storage

# How the crawler introduces itself.
EURIPONTIDA_CRAWLEE_USER_AGENT=euripontida-crawlee/0.1 (+https://github.com/euripontida-crawlee; polite crawler)

# Politeness and pacing.
EURIPONTIDA_CRAWLEE_MIN_CONCURRENCY=1
EURIPONTIDA_CRAWLEE_DESIRED_CONCURRENCY=3
EURIPONTIDA_CRAWLEE_MAX_CONCURRENCY=8
EURIPONTIDA_CRAWLEE_MAX_REQUESTS_PER_MINUTE=60
EURIPONTIDA_CRAWLEE_MAX_REQUEST_RETRIES=3
EURIPONTIDA_CRAWLEE_REQUEST_TIMEOUT_SECONDS=60
EURIPONTIDA_CRAWLEE_RESPECT_ROBOTS=true

# Guards that refuse to write a snapshot from a run that went badly.
# Success rate counts failures among the pages attempted; coverage asks how much
# of the previous snapshot this run reached at all.
EURIPONTIDA_CRAWLEE_MIN_SUCCESS_RATE=0.9
EURIPONTIDA_CRAWLEE_MIN_COVERAGE=0.5

# Browser mode.
EURIPONTIDA_CRAWLEE_HEADLESS=true

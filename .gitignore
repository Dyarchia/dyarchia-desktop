# Crawlee working directory (request queues, datasets, key-value stores)
storage/

# Ad-hoc run output
output/

# Snapshot payloads. Only the metadata beside them is tracked: manifest.json
# records every URL with its status and hash, and changes.json and CHANGES.md
# record what moved between runs, diffs included. The scraped corpus itself
# does not belong in the toolkit's repository.
data/*/pages/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

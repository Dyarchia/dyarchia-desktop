# Copy to .env to change the defaults. The file is ignored by git.
# Every setting is optional; what is shown is the value used when it is absent.

# Where snapshots live. Accepts an absolute path, so the scraped corpus can sit
# anywhere on disk, outside this project entirely. Nothing in the toolkit reads
# it except to compare a new run against the previous one, so moving it only
# means telling the toolkit where it went.
CRAWLEE_LAB_DATA_DIR=data

# Where ad-hoc run output lands, and where profiles are looked up.
CRAWLEE_LAB_OUTPUT_DIR=output
CRAWLEE_LAB_PROFILES_DIR=profiles

# How the crawler introduces itself.
CRAWLEE_LAB_USER_AGENT=crawlee-lab/0.1 (+https://github.com/crawlee-lab; polite crawler)

# Politeness and pacing.
CRAWLEE_LAB_MIN_CONCURRENCY=1
CRAWLEE_LAB_DESIRED_CONCURRENCY=3
CRAWLEE_LAB_MAX_CONCURRENCY=8
CRAWLEE_LAB_MAX_REQUESTS_PER_MINUTE=60
CRAWLEE_LAB_MAX_REQUEST_RETRIES=3
CRAWLEE_LAB_REQUEST_TIMEOUT_SECONDS=60
CRAWLEE_LAB_RESPECT_ROBOTS=true

# Guards that refuse to write a snapshot from a run that went badly.
# Success rate counts failures among the pages attempted; coverage asks how much
# of the previous snapshot this run reached at all.
CRAWLEE_LAB_MIN_SUCCESS_RATE=0.9
CRAWLEE_LAB_MIN_COVERAGE=0.5

# Browser mode.
CRAWLEE_LAB_HEADLESS=true

# The audit command, which is the only part of this toolkit that can cost money.
# Without a key it still runs its local checks and reports them; the model tiers
# are simply skipped. Nothing is ever submitted without printing the projected
# cost first, and nothing above the ceiling is submitted at all.
ANTHROPIC_API_KEY=
CRAWLEE_LAB_AUDIT_FAST_MODEL=claude-haiku-4-5
CRAWLEE_LAB_AUDIT_CAREFUL_MODEL=claude-sonnet-5
CRAWLEE_LAB_AUDIT_ARBITER_MODEL=claude-opus-5
CRAWLEE_LAB_AUDIT_MAX_SPEND_USD=5.0

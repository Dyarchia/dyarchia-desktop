# Crawlee working directory (request queues, datasets, key-value stores)
storage/

# Ad-hoc run output
output/

# Scraped sites, in full: payloads, manifests and change reports alike.
# Change detection does not depend on git. The manifest on disk holds the
# previous hash of every page and the stored pages hold the previous text,
# which is what a run compares against. Keeping data/ out of the repository
# costs the long-term history, not the detection.
data/

# Spanish-language tutorial, kept locally
docs/tutorial.md

# Scraped reference material, kept locally alongside the corpora it belongs with
docs/reference/

# Target definitions, which describe somebody's corpus rather than the tool.
# The package still ships one profile under src/crawlee_lab/sites/ as the worked
# example; everything a given machine tracks lives here, untracked.
profiles/*.yaml
profiles/*.yml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

{
    "id": "crawlee",
    "name": "Crawlee",
    "version": "0.1.0",
    "toolbar": 5,
    "renderer": "renderer.js",
    "python": "main.py",
    "channels": [
        "state",
        "profiles",
        "show",
        "save",
        "delete",
        "search",
        "start",
        "stop",
        "catalog",
        "install",
        "changes"
    ],
    "boot": true,
    "description": "Documentation snapshots, change reports and search",
    "data": "crawlee",
    "requires": [
        {
            "kind": "python",
            "label": "Python environment",
            "project": ".",
            "postInstall": [
                [
                    "playwright",
                    "install",
                    "chromium"
                ]
            ],
            "verify": [
                "python",
                "-c",
                "import os, sys\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n    sys.exit(0 if os.path.exists(p.chromium.executable_path) else 1)"
            ],
            "note": "up to 1.2 GB"
        }
    ],
    "files": [
        "src",
        "catalog",
        "pyproject.toml",
        "uv.lock",
        "README.md",
        ".env.example"
    ]
}

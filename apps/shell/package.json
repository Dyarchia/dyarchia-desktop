{
    "name": "@dyarchia/shell",
    "productName": "dyarchia",
    "version": "0.2.1-alpha",
    "private": true,
    "type": "module",
    "main": "./out/main/index.js",
    "scripts": {
        "predev": "node ../../scripts/ensure-runtime.mjs",
        "dev": "electron-vite dev --watch",

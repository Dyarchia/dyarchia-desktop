# Crawlee working directory (request queues, datasets, key-value stores)
storage/

# Ad-hoc run output
output/

# Scraped sites, in full: payloads, manifests and change reports alike.
# Change detection does not depend on git. The manifest on disk holds the
# previous hash of every page and the stored pages hold the previous text,
# which is what a run compares against. Keeping data/ out of the repository
# costs the long-term history, not the detection.
data/

# Spanish-language tutorial, kept locally
docs/tutorial.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

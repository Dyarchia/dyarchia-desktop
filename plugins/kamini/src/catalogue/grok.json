        "run_terminal_command",
        "web_search",
        "web_fetch",
        "todo_write",
        "spawn_subagent",
        "get_command_or_subagent_output",
        "kill_command_or_subagent",
        "wait_commands_or_subagents",
        "send_subagent_message",
        "search_tool",
        "use_tool",
        "ask_user_question",
        "image_gen",
        "image_edit",
        "image_to_video",

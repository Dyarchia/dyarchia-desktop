        "wait_for_instruction"
    ],
    "events": [
        {
            "name": "SessionStart",
            "note": "A session starts (not a subagent's own); matcher tests the start source such as startup or resume.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "UserPromptSubmit",
            "note": "A typed prompt is submitted; can block it (exit 2 or decision block); matcher ignored; 30 s default timeout.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "PreToolUse",
            "note": "Before a tool runs; matcher tests the tool name; can allow, deny, ask, defer or rewrite input.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "PostToolUse",
            "note": "A tool finished; matcher tests the tool name; can add context or replace the output the model sees.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "PostToolUseFailure",
            "note": "A tool failed to dispatch or an MCP tool returned an error; matcher tests the tool name.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "PermissionDenied",
            "note": "The permission system denied a tool call; matcher tests the tool name.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "Stop",
            "note": "A turn ends on a genuine completion; can block the stop to keep working; matcher ignored.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "StopFailure",
            "note": "A turn ends on an API error; matcher tests the error type such as rate_limit or server_error.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "StopCancelled",
            "note": "A turn ends without completing (interrupt, rejection, max_turns, no_progress); matcher tests the reason.",
            "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md#hook-events"
        },
        {
            "name": "Notification",
            "note": "A user-attention event; matcher tests the notification type such as idle_prompt or permission_prompt.",

{
    "name": "@decimatio/plugin-terminal",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm build:renderer && pnpm build:main",
        "build:renderer": "esbuild src/renderer.ts --bundle --format=esm --loader:.css=text --outfile=dist/renderer.js",
        "build:main": "esbuild src/main.ts --bundle --platform=node --format=esm --external:node-pty --outfile=dist/main.js"
    },
    "dependencies": {
        "node-pty": "^1.0.0"
    },
    "devDependencies": {
        "@decimatio/sdk": "workspace:*",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.0"
    }
}
